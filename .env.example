# Copia este archivo como .env y completa tu API key (Organization Settings > API Keys en Datadog)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_HOSTNAME=products-local
DD_ENV=development

# PostgreSQL (deben coincidir con ConnectionStrings:Default de appsettings.Development.json)
POSTGRES_DB=products
POSTGRES_USER=products
POSTGRES_PASSWORD=products

# Contraseña del usuario de monitoreo "datadog" en Postgres
DD_POSTGRES_PASSWORD=datadog
